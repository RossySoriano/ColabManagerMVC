@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}
<style>
    body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        font-family: Arial, sans-serif;
    }

    .login-container {
        background-color: white;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        margin: 100px auto;
        max-width: 400px;
        padding: 30px;
    }

    .login-title {
        color: #333;
        font-size: 24px;
        margin-bottom: 20px;
        text-align: center;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            color: #555;
            display: block;
            font-size: 14px;
            margin-bottom: 5px;
        }

    .form-control {
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 16px;
        padding: 10px;
        width: 100%;
    }

        .form-control:focus {
            border-color: #4a90e2;
            box-shadow: 0 0 0 2px rgba(74, 144, 226, 0.2);
            outline: none;
        }

    .btn-success {
        background-color: #4CAF50;
        border: none;
        border-radius: 4px;
        color: white;
        cursor: pointer;
        font-size: 16px;
        padding: 12px 20px;
        transition: background-color 0.3s;
        width: 100%;
    }

        .btn-success:hover {
            background-color: #45a049;
        }
</style>

<div class="login-container">
    <h2 class="login-title">Iniciar sesión</h2>
    <form id="frmAcceder">
        <div class="form-group">
            <label for="usuario">Usuario</label>
            <input type="text"
                   id="usuario"
                   name="usuario"
                   class="form-control" />
        </div>
        <div class="form-group">
            <label for="password">Password</label>
            <input type="password"
                   id="password"
                   name="password"
                   class="form-control" />
        </div>
        <div class="form-group">
            <input type="submit"
                   class="btn btn-success"
                   value="Entrar" />
        </div>
    </form>
</div>

@section scripts
{
    <script>
        $(document).ready(function () {
            $("#frmAcceder").submit(function (e) {
                e.preventDefault();

                var url = "@Url.Content("~/Acceder/Enter")";
                var parametros = $(this).serialize();

                $.post(url, parametros, function (data) {
                    if (data == "1") {
                        window.location.href = "@Url.Content("~/")";
                    } else {
                        alert(data);
                    }
                });
            });
        });
    </script>
}
