@model List<PSS06.Models.LabColaborador>

@{
    ViewBag.Title = "Lista de Colaboradores";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";  // Asegúrate de tener este layout o ajusta según corresponda
}

<div class="container">
    <h2>Lista de Colaboradores</h2>

    @if (Model.Count > 0)
    {
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Colaborador</th>
                    <th>Nombre</th>
                    <th>Estatus</th>
                    <th>Departamento</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var colaborador in Model)
                {
                    <tr>
                        <td>@colaborador.Colaborador</td>
                        <td>@colaborador.NombreColaborador</td>
                        <td>@colaborador.Estatus</td>
                        <td>@colaborador.Departamento</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No se encontraron colaboradores.</p>
    }
</div>
